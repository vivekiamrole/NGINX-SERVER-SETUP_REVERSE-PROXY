Main config:
 /etc/nginx/nginx.conf

Website configs:
 /etc/nginx/sites-available/

Enabled configs:
 /etc/nginx/sites-enabled/

Default website:
 /var/www/html/

Default config:
 /etc/nginx/sites-available/default

Logs:
 /var/log/nginx/


----------------------------------------------------------------------
SERVER CONFIURATION FILE
---------------------------------------------------------------------------------
user www-data;

worker_processes auto;

pid /run/nginx.pid;

events {
    worker_connections 768;
}

http {
    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    # Logs
    access_log /var/log/nginx/vivek_access.log;
    error_log  /var/log/nginx/vivek_error.log;


    # =========================================
    # WEBSITE 1 - PORT 80+ proxy SERVER
    # =========================================

    server {
        listen 80;
        listen [::]:80;

        server_name _;

        root /var/www/html;
        index index.nginx-debian.html;

        location / {
            try_files $uri $uri/ =404;
			#or for proxy remove upper try files and paste 
			 proxy_pass http://127.0.0.1:5000;   #(5000 means node.js)

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }


    # =========================================
    # WEBSITE 2 - PORT 8080
    # =========================================

    server {
        listen 8080;
        listen [::]:8080;

        server_name _;

        root /home/ubuntu/vivek;
        index index.html;

        location / {
            try_files $uri $uri/ =404;
        }
    }
}
